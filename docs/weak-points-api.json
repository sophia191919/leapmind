{
  "apiTitle": "LeapMind 薄弱点分析 API",
  "version": "4.1.2+4.1.3",
  "baseUrl": "http://localhost:8080",
  "auth": {
    "type": "Bearer Token (JWT)",
    "loginEndpoint": "POST /api/auth/login",
    "testAccount": {"username": "admin", "password": "admin123"},
    "obtainToken": "curl -s -X POST http://localhost:8080/api/auth/login -H 'Content-Type: application/json' -d '{\"username\":\"admin\",\"password\":\"admin123\"}'",
    "headerFormat": "Authorization: Bearer {token}"
  },
  "endpoints": [
    {
      "id": "WP-001",
      "method": "GET",
      "path": "/api/weak-points",
      "group": "薄弱点查询",
      "summary": "查询用户薄弱点列表",
      "parameters": {
        "userId": {"type": "integer", "required": true, "description": "用户ID", "example": 1},
        "subject": {"type": "string", "required": false, "description": "学科过滤", "example": "数学"},
        "status": {"type": "string", "required": false, "description": "ACTIVE/RESOLVED/IMPROVING"}
      },
      "curl": "curl -s 'http://localhost:8080/api/weak-points?userId=1' -H 'Authorization: Bearer {token}'",
      "sortRule": "HIGH > MEDIUM > LOW，同级按errorCount降序",
      "response": {"code": 200, "message": "查询成功", "data": ["UserWeakPointVO[]"]},
      "responseExample": {
        "code": 200,
        "message": "查询成功",
        "data": [{
          "id": 11, "userId": 1, "knowledgePoint": "圆的面积", "subject": "数学",
          "weaknessLevel": "HIGH", "errorCount": 9, "totalCount": 15,
          "accuracyRate": 40.0, "status": "ACTIVE",
          "aiAnalysis": null, "aiSuggestion": null
        }, {
          "id": 8, "userId": 1, "knowledgePoint": "分数加减法", "subject": "数学",
          "weaknessLevel": "HIGH", "errorCount": 8, "totalCount": 12,
          "accuracyRate": 33.33, "status": "ACTIVE"
        }],
        "timestamp": 1784733787107
      }
    },
    {
      "id": "WP-002",
      "method": "GET",
      "path": "/api/weak-points/{userId}",
      "group": "薄弱点查询",
      "summary": "查询单个用户所有薄弱点",
      "parameters": {
        "userId": {"type": "integer", "required": true, "description": "路径参数: 用户ID", "example": 1}
      },
      "curl": "curl -s 'http://localhost:8080/api/weak-points/1' -H 'Authorization: Bearer {token}'",
      "responseExample": {
        "code": 200, "message": "查询成功",
        "data": "同 WP-001 全量查询", "timestamp": 1784733787107
      }
    },
    {
      "id": "WP-003",
      "method": "POST",
      "path": "/api/weak-points/{userId}/analysis",
      "group": "AI分析",
      "summary": "触发AI综合分析",
      "description": "调用Python AI服务生成综合分析+学习建议。Python不可用时自动降级为本地Markdown分析。",
      "parameters": {
        "userId": {"type": "integer", "required": true, "description": "路径参数: 用户ID", "example": 1}
      },
      "curl": "curl -s -X POST 'http://localhost:8080/api/weak-points/1/analysis' -H 'Authorization: Bearer {token}'",
      "response": {"code": 200, "message": "分析完成", "data": "WeakPointsAnalysisVO"},
      "responseExample": {
        "code": 200,
        "message": "分析完成",
        "data": {
          "comprehensiveAnalysis": "## 薄弱点分析\n\n- **圆的面积**（数学）：错误9次，薄弱程度高\n- **分数加减法**（数学）：错误8次，薄弱程度高\n\n### 学习建议\n建议优先复习以上知识点。",
          "learningSuggestions": "建议每天针对薄弱知识点进行专项练习。",
          "detailAnalyses": [],
          "recommendedPriority": ["圆的面积", "分数加减法"]
        },
        "timestamp": 1784733787107
      }
    },
    {
      "id": "WP-004",
      "method": "GET",
      "path": "/api/exercises/recommend",
      "group": "练习推荐",
      "summary": "获取推荐练习",
      "description": "去重:排除7天内已做。优先级:RESOLVED(pri=1)>ACTIVE按HIGH>MEDIUM>LOW(pri=2)。",
      "parameters": {
        "userId": {"type": "integer", "required": true},
        "subject": {"type": "string", "required": false},
        "knowledgePoint": {"type": "string", "required": false},
        "count": {"type": "integer", "required": false, "default": 5}
      },
      "curl": "curl -s 'http://localhost:8080/api/exercises/recommend?userId=1&subject=数学&count=3' -H 'Authorization: Bearer {token}'",
      "responseExample": {
        "code": 200, "message": "推荐成功",
        "data": [
          {"exerciseId": "ACTIVE_1_圆的面积", "knowledgePoint": "圆的面积", "subject": "数学", "sourceType": "ACTIVE_WEAK_POINT", "priority": 2},
          {"exerciseId": "ACTIVE_1_分数加减法", "knowledgePoint": "分数加减法", "subject": "数学", "sourceType": "ACTIVE_WEAK_POINT", "priority": 2}
        ],
        "timestamp": 1784733799065
      }
    },
    {
      "id": "WP-005",
      "method": "POST",
      "path": "/api/exercises/record",
      "group": "练习推荐",
      "summary": "记录练习结果",
      "description": "记录练习并自动更新薄弱点:正确率、状态。正确率>=80%标记RESOLVED。",
      "requestBody": {
        "userId": {"type": "integer", "required": true},
        "exerciseId": {"type": "string", "required": true},
        "isCorrect": {"type": "integer", "required": true, "enum": [0, 1]},
        "knowledgePoint": {"type": "string", "required": false},
        "subject": {"type": "string", "required": false}
      },
      "curl": "curl -s -X POST 'http://localhost:8080/api/exercises/record' -H 'Content-Type: application/json' -H 'Authorization: Bearer {token}' -d '{\"userId\":1,\"exerciseId\":\"TEST_001\",\"knowledgePoint\":\"fraction\",\"subject\":\"math\",\"isCorrect\":1}'",
      "responseExample": {
        "code": 200, "message": "记录成功", "data": "ok", "timestamp": 1784970682596
      },
      "errorExample": {
        "code": 400, "message": "用户ID不能为空", "data": null, "timestamp": 1784733787107
      }
    },
    {
      "id": "WP-006",
      "method": "GET",
      "path": "/api/weak-points/recommend-questions",
      "group": "薄弱点详情页",
      "summary": "推荐题目（薄弱点详情页）",
      "description": "根据具体知识点的薄弱程度推荐对应难度的练习题。难度: HIGH薄弱点→EASY基础题, MEDIUM→MEDIUM中等题, LOW→HARD提高题。",
      "parameters": {
        "userId": {"type": "integer", "required": true, "description": "用户ID", "example": 1},
        "knowledgePoint": {"type": "string", "required": true, "description": "知识点名称", "example": "fraction"},
        "count": {"type": "integer", "required": false, "default": 5, "description": "推荐数量"}
      },
      "curl": "curl -s 'http://localhost:8080/api/weak-points/recommend-questions?userId=1&knowledgePoint=fraction&count=3' -H 'Authorization: Bearer {token}'",
      "responseExample": {
        "code": 200,
        "message": "推荐成功",
        "data": [{
          "questionId": "Q_1_fraction_1",
          "knowledgePoint": "fraction",
          "subject": "math",
          "difficulty": "MEDIUM",
          "questionType": "选择题",
          "questionTitle": "关于「fraction」的基础练习题",
          "reason": "该知识点掌握一般，建议进行中等难度练习"
        }]
      }
    },
    {
      "id": "WP-007",
      "method": "GET",
      "path": "/api/weak-points/knowledge-graph",
      "group": "知识图谱页",
      "summary": "知识图谱",
      "description": "获取用户知识图谱:知识点节点(含掌握率、薄弱程度)+前置依赖边。同科知识点按薄弱程度排序建立prerequisite关系链。掌握率>=80%标记MASTERED。",
      "parameters": {
        "userId": {"type": "integer", "required": true, "description": "用户ID", "example": 1},
        "subject": {"type": "string", "required": false, "description": "学科过滤(空=全部)", "example": "math"}
      },
      "curl": "curl -s 'http://localhost:8080/api/weak-points/knowledge-graph?userId=1&subject=math' -H 'Authorization: Bearer {token}'",
      "responseExample": {
        "code": 200,
        "message": "查询成功",
        "data": {
          "nodes": [
            {"id": "fraction", "name": "fraction", "subject": "math", "weaknessLevel": "MASTERED", "masteryRate": 100.0, "group": "math"},
            {"id": "circle", "name": "circle", "subject": "math", "weaknessLevel": "MEDIUM", "masteryRate": 0.0, "group": "math"}
          ],
          "edges": [
            {"source": "fraction", "target": "circle", "relation": "prerequisite"}
          ]
        }
      }
    }
  ],
  "pythonService": {
    "serviceName": "LeapMind 薄弱点 AI 分析服务",
    "baseUrl": "http://localhost:8000",
    "endpoints": [{
      "id": "PY-001",
      "method": "POST",
      "path": "/api/weak-points/analyze",
      "summary": "AI薄弱点综合分析",
      "curl": "curl -s -X POST 'http://localhost:8000/api/weak-points/analyze' -H 'Content-Type: application/json' -d '{\"userId\":1,\"weakPoints\":[{\"knowledgePoint\":\"fraction\",\"subject\":\"math\",\"weaknessLevel\":\"HIGH\",\"errorCount\":8}],\"recentExercises\":[],\"language\":\"zh\"}'"
    }]
  },
  "integrationTest": {
    "prerequisites": ["MySQL leapmind-voice 已创建", "Java:8080 运行中", "Python:8000(可选)"],
    "steps": [
      "1. POST /api/auth/login → 获取token",
      "2. GET /api/weak-points?userId=1 → 6条 HIGH优先",
      "3. GET /api/weak-points?userId=1&subject=数学 → 3条",
      "4. GET /api/exercises/recommend?userId=1&subject=数学&count=3 → 3条 HIGH优先",
      "5. POST /api/exercises/record → 记录练习",
      "6. GET /api/weak-points/recommend-questions?userId=1&knowledgePoint=fraction → 推荐题目",
      "7. GET /api/weak-points/knowledge-graph?userId=1&subject=math → 节点+边",
      "8. POST /api/weak-points/1/analysis → AI分析(降级模式)"
    ]
  }
}
