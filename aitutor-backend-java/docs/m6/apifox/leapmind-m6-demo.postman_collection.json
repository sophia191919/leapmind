{
  "info": {
    "_postman_id": "43e3bbca-e4a1-461b-9342-afbf1aaad17a",
    "name": "LeapMind M6 上下文记忆与用户画像演示",
    "description": "Apifox 演示集合。真实调用前先执行“登录并提取 Token/UserId”；后端未就绪时，只打开内置离线响应示例，不发送请求。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "00 登录与环境",
      "item": [
        {
          "name": "登录并提取 Token/UserId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('登录返回 token 和 userId', () => {",
                  "  pm.expect(json.data.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.userInfo.id).to.exist;",
                  "});",
                  "pm.environment.set('accessToken', json.data.token);",
                  "pm.environment.set('userId', String(json.data.userInfo.id));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "使用本地演示账号登录。后置脚本会把 data.token 与 data.userInfo.id 写入当前 Apifox 环境。"
          },
          "response": [
            {
              "name": "200 登录成功（离线示例）",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": 200,\n  \"message\": \"success\",\n  \"data\": {\n    \"token\": \"demo.jwt.placeholder\",\n    \"expiresIn\": 7200,\n    \"userInfo\": {\n      \"id\": 1,\n      \"username\": \"demo_user\"\n    }\n  },\n  \"timestamp\": 1785456000000\n}"
            }
          ]
        },
        {
          "name": "验证当前用户",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "profile"
              ]
            },
            "description": "确认当前环境的 Bearer Token 可用。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "01 事件采集（主演示）",
      "item": [
        {
          "name": "1. 首次写入 - ACCEPTED",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.environment.set('eventId', `apifox-answer-${suffix}`);",
                  "pm.environment.set('occurredAt', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('首次写入为 ACCEPTED', () => {",
                  "  pm.expect(json.data.eventStatus).to.eql('ACCEPTED');",
                  "  pm.expect(json.data.duplicate).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-Id",
                "value": "apifox-demo-accepted"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"userId\": {{userId}},\n  \"eventType\": \"answer_question\",\n  \"sourceModule\": \"M1\",\n  \"occurredAt\": \"{{occurredAt}}\",\n  \"schemaVersion\": \"1.0\",\n  \"sessionId\": \"apifox-demo-session\",\n  \"kpId\": {{kpId}},\n  \"traceId\": \"apifox-demo-trace\",\n  \"data\": {\n    \"isCorrect\": false,\n    \"difficulty\": 3,\n    \"timeSpentSec\": 42,\n    \"hintCount\": 1,\n    \"confusionTag\": \"concept_unclear\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/user-profile/{{userId}}/record-event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user-profile",
                "{{userId}}",
                "record-event"
              ]
            },
            "description": "每次发送前生成新的 eventId，演示事件被接收并进入画像投影队列。"
          },
          "response": [
            {
              "name": "200 ACCEPTED（离线示例）",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
